# Attendance portal — web front end (Next.js) settings.
# Copy to `.env.local` (read automatically by `next start` / `next dev`). Never commit it.

# Where the FastAPI server listens. The browser never talks to it directly — every call goes
# through this app's /api/backend proxy, so keep the API on a private address.
ATTENDANCE_API_BASE=http://127.0.0.1:8079

# Session cookies are `Secure` (HTTPS only) by default. Set to 1 ONLY to try the site over
# plain http://localhost — never on a real deployment. Also disables the HSTS header.
# ATTENDANCE_INSECURE_COOKIES=1
