# Attendance portal — API server (FastAPI) settings.
#
# Copy to `.env` and fill in. The API reads it with:
#     python -m uvicorn app.api:app --env-file .env --host 127.0.0.1 --port 8079
# tools/seed_portal.py and tools/backup.py read the same file.
# NEVER commit `.env` — it is in .gitignore.

# --- Required in production -------------------------------------------------------------
# `production` makes the server refuse to start without the two secrets below, turns off the
# auto-generated development keys, and blocks tools/seed_portal.py.
ATTENDANCE_ENV=production

# Signs login tokens. 32+ random bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ATTENDANCE_JWT_SECRET=

# Encrypts face templates, camera passwords and review snapshots at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KEEP A COPY IN YOUR PASSWORD MANAGER. Backups are useless without it, and changing it makes
# every enrolled face unreadable (students would have to enrol again).
ATTENDANCE_FERNET_KEY=

# --- Database ------------------------------------------------------------------------------
# Default: SQLite file var/attendance.db (fine for one college on one server).
# PostgreSQL (needs `pip install "psycopg[binary]"`):
#   ATTENDANCE_DB_URL=postgresql+psycopg://attendance:PASSWORD@db-host:5432/attendance
ATTENDANCE_DB_URL=sqlite:///var/attendance.db

# --- Public address ------------------------------------------------------------------------
# Where students open the website. Used for links in emails (verify, reset password, open a
# notification). Must be the HTTPS address in production — phone cameras and location only
# work on HTTPS.
ATTENDANCE_PUBLIC_URL=https://attendance.your-college.edu

# Reverse proxies whose X-Forwarded-For header is trusted for rate limiting (comma-separated
# IPs). Default is loopback, which is right when Next.js and the API run on the same machine.
ATTENDANCE_TRUSTED_PROXIES=127.0.0.1,::1

# --- Email (OTP codes, approvals, alerts, weekly summaries) --------------------------------
# Without SMTP_HOST, emails are written to var/outbox/*.eml instead of being sent, and the
# admin dashboard shows a warning.
SMTP_HOST=smtp.your-college.edu
SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Attendance Office <attendance@your-college.edu>

# --- Storage locations (optional; defaults shown) ------------------------------------------
# ATTENDANCE_UPLOAD_DIR=var/uploads      profile photos and attachments — back this up
# ATTENDANCE_REVIEW_DIR=var/review       encrypted CCTV crops awaiting review (auto-deleted)
# ATTENDANCE_OUTBOX=var/outbox           emails when SMTP is not configured

# --- Development / testing only — leave unset in production ---------------------------------
# ATTENDANCE_DISABLE_BACKGROUND=1        no scheduler (session auto-start/close, email sending)
# ATTENDANCE_DISABLE_RATE_LIMIT=1
